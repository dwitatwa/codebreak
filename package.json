{
  "name": "codebreak-monorepo",
  "private": true,
  "license": "MIT",
  "version": "0.5.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "bun run packages/cli/src/cli.ts",
    "test": "bun test --timeout 30000",
    "build": "bun run packages/cli/scripts/build.ts",
    "build:viewer": "bun run packages/viewer/scripts/build.ts && bun run packages/cli/scripts/gen-manifest.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
